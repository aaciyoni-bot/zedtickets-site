rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════
//  SHARED "Zed Zambia" Firestore rules — deployed to project zedmall-4301c
//  One Firebase project backs the whole ORIZIS Zambia family. Each product
//  owns its own top-level collections; everything not listed is denied.
//
//  Products & collections covered here:
//   • ZedTickets  — events, tickets, campaigns, contributions
//   • ORIZIS Academy — enrollments, certificates
//  (The Zed stores run in demo/localStorage mode and touch no collections.)
//
//  Deploy:  firebase deploy --only firestore:rules --project zedmall-4301c
// ═══════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    /* ═══════════════ ZEDTICKETS ═══════════════ */

    match /events/{eventId} {
      allow read: if true;                                   // public listings
      allow create: if isOwner(request.resource.data.organizerId);
      allow update, delete: if isOwner(resource.data.organizerId);
    }

    match /tickets/{ticketId} {
      allow get: if true;                                    // buyer loads their ticket by id
      allow list: if isOwner(resource.data.organizerId);     // organizer dashboard
      allow create: if request.resource.data.token is string
                    && request.resource.data.status == 'valid'
                    && request.resource.data.organizerId is string
                    && request.resource.data.eventId is string;
      allow update: if isOwner(resource.data.organizerId)    // gate scan → used
                    && request.resource.data.status == 'used'
                    && request.resource.data.eventId == resource.data.eventId
                    && request.resource.data.organizerId == resource.data.organizerId
                    && request.resource.data.token == resource.data.token;
      allow delete: if isOwner(resource.data.organizerId);
    }

    match /campaigns/{campaignId} {
      allow read: if true;
      allow create: if isOwner(request.resource.data.organizerId);
      allow delete: if isOwner(resource.data.organizerId);
      allow update: if isOwner(resource.data.organizerId)
                    || (
                         request.resource.data.raisedZmw >= resource.data.raisedZmw
                         && request.resource.data.diff(resource.data)
                              .affectedKeys().hasOnly(['raisedZmw', 'contributionsCount'])
                       );
    }

    match /contributions/{contributionId} {
      allow create: if request.resource.data.token is string
                    && request.resource.data.amountZmw is number
                    && request.resource.data.amountZmw > 0
                    && request.resource.data.organizerId is string
                    && request.resource.data.campaignId is string;
      allow read: if isOwner(resource.data.organizerId);
      allow update, delete: if false;
    }

    /* ═══════════════ ORIZIS ACADEMY ═══════════════ */

    // A learner's own course progress. Private to that learner.
    match /enrollments/{enrollId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId)
                    && request.resource.data.userId == resource.data.userId;
      allow delete: if false;
    }

    // Certificates are publicly verifiable (verify.html looks one up by id),
    // created by the learner who earned it, and immutable afterwards.
    // Anti-forgery: a certificate can only be issued if the learner has a
    // COMPLETED enrollment for that course (enrollment id = uid_courseId).
    match /certificates/{certId} {
      allow read: if true;                                   // public verification
      allow create: if isOwner(request.resource.data.userId)
                    && exists(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + request.resource.data.courseId))
                    && get(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + request.resource.data.courseId)).data.status == 'completed';
      allow update, delete: if false;
    }

    /* ═══════════════ GOOJOB / SwipeJob ═══════════════ */

    // A member's own membership record, keyed by their uid, so a subscription
    // bought on one phone is restored when they sign in on another. It carries
    // the server-signed receipt (membershipId + token) issued only after a
    // verified payment — the backend can re-check it via /api/verify-membership.
    match /goojob_members/{uid} {
      allow read, write: if isOwner(uid) && request.auth.uid == uid;
    }

    /* ═══════════════ ZED STORES — ORDERS ═══════════════ */
    // Shared order inbox for the 6 Zed physical stores (zedtech/mall/glow/home/
    // solar/baby). Customers are anonymous, so create is public but shape-checked;
    // orders carry customer PII, so reading/updating is admin-only.
    function isZedAdmin() {
      return request.auth != null
             && request.auth.token.email in ['aaci.yoni@gmail.com', 'office@orizisgroup.com'];
    }
    match /orders/{orderId} {
      allow create: if request.resource.data.store is string
                    && request.resource.data.total is number
                    && request.resource.data.items is list
                    && request.resource.data.status == 'new';
      allow read, update: if isZedAdmin();
      allow delete: if false;
    }

    /* ═══════════════ ORIZIS ACADEMY — SCHOLARSHIPS ═══════════════ */
    // A learner's own subsidy application (name, contact, age, town, employment,
    // motivation). Owner may create/read their own; the admin can read them all.
    // No sensitive ID/biometric data is collected here.
    match /scholarships/{id} {
      allow create: if isOwner(request.resource.data.userId);
      allow read:   if isOwner(resource.data.userId) || isZedAdmin();
      allow update, delete: if false;
    }
  }
}
